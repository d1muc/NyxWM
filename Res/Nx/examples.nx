// ---------------------------------------------------------------------------
// examples.nx — примеры того, что умеет .nx.
//
// Все поверхности ниже выключены (enabled: false), поэтому сейчас на экране
// ничего нет. Поставь enabled: true, сохрани файл — поверхность появится сразу.
// Перезапускать приложение не нужно: файлы читаются на лету.
//
// Полное описание языка — в README.md рядом с этим файлом.
// ---------------------------------------------------------------------------


// ---------------------------------------------------------------------------
// 1. Док снизу: плоские квадратные кнопки.
//    Ни градиентов, ни прозрачности, ни сглаженных углов — один цвет и
//    прямоугольники, если тебе не нравятся мягкие формы.
// ---------------------------------------------------------------------------
surface #dock:
    enabled: false
    position: bottom                 // top, bottom, left, right, center, float
    anchor: center                   // left, center, right (для top/bottom)
    width: auto                      // по содержимому
    height: 48
    margin: 14
    monitor: -1                      // -1 — монитор под курсором, 0,1,2 — номер

    row:
        gap: 6
        padding: 6
        cross: center
        // background не объявлен — значит фон полностью прозрачный

        button #files:
            action: "command:explorer"   // "команда:аргумент", кавычки обязательны
            icon: "icons/test.png"   // своя картинка: путь в кавычках, от этого файла
            iconsize: 18
            width: 36
            height: 36
            shape: square            // square — ровные углы, radius не нужен
            background: #2b2f3a      // один цвет, без второго цвета в списке
            foreground: #e6e9ef
            tooltip: "Проводник"
            animate: pop

        button #term:
            action: terminal
            icon: terminal
            iconsize: 18
            width: 36
            height: 36
            shape: square
            background: #2b2f3a
            foreground: #e6e9ef
            tooltip: "Терминал"

        button #cfg:
            action: settings
            icon: settings
            iconsize: 18
            width: 36
            height: 36
            shape: square
            background: #2b2f3a
            foreground: #e6e9ef
            tooltip: "Настройки"

        divider:
            width: 1
            height: 22
            background: #3a3f4b

        button #quit:
            action: exit
            icon: power
            iconsize: 18
            width: 36
            height: 36
            shape: square
            background: #3a2530
            foreground: #f7768e
            tooltip: "Выход"


// ---------------------------------------------------------------------------
// 2. Плавающий виджет: свои фигуры, своя анимация, живые данные.
//    Анимация объявлена тут же, в этом файле, — она видна только этому файлу
//    и не мешает анимациям из theme.nx.
// ---------------------------------------------------------------------------
animation pulse:
    duration: 900ms
    loop: true
    alternate: true
    easing: sine
    {
        scale: 0.85
        opacity: 0.6
    }
    100% {
        scale: 1.15
        opacity: 1
    }

surface #stage:
    enabled: false
    position: float                  // float — от угла монитора плюс отступы ниже
    offsetx: 40
    offsety: 140
    width: 250
    height: 104
    opacity: 0.95

    row:
        gap: 10
        padding: 10
        background: [#1b1f2a, #12151c]   // два цвета в списке — вертикальный градиент
        radius: 12
        border: #2f3542
        borderwidth: 1
        cross: center

        circle #live:                // имя фигуры можно писать элементом
            width: 26
            height: 26
            background: #7aa2f7
            animate: pulse

        triangle #mark:
            width: 22
            height: 22
            background: #9ece6a

        column #info:
            gap: 2

            label #title:
                text: "Сейчас играет"
                fontsize: 11
                foreground: #99a3b3
                align: left

            label #track:
                text: "{default(media.artist, '—')} — {default(media.title, 'тишина')}"
                fontsize: 13
                foreground: #e6e9ef
                align: left

            bar #progress:
                value: "{media.progress}"    // media.progress — доля от 0 до 1
                max: 1
                width: 190
                height: 4
                radius: 2
                background: #262b36
                fill: #7aa2f7


// ---------------------------------------------------------------------------
// 3. Панель справа снизу: системная информация.
//    Каждая строка — label с подстановкой {namespace.key}.
// ---------------------------------------------------------------------------
surface #ticker:
    enabled: false
    position: bottom
    anchor: right
    width: 210
    height: auto
    margin: 14
    clickthrough: true               // клики проходят сквозь панель

    column:
        gap: 4
        padding: 10
        background: #cc12151c
        radius: 12
        border: #1fffffff
        borderwidth: 1

        row:
            gap: 8
            cross: center

            box:
                icon: globe
                iconsize: 14
                foreground: #7aa2f7

            label:
                text: "{sys.language} / {sys.country}"
                fontsize: 11
                foreground: #e6e9ef
                align: left

        row:
            gap: 8
            cross: center

            box:
                icon: window
                iconsize: 14
                foreground: #99a3b3

            label:
                text: "окон: {win.count}, свёрнуто: {win.minimized}"
                fontsize: 11
                foreground: #99a3b3
                align: left

        row:
            gap: 8
            cross: center

            box:
                icon: cpu
                iconsize: 14
                foreground: #99a3b3

            label:
                text: "процессов: {sys.processcount}, RAM: {round(sys.mem)}%"
                fontsize: 11
                foreground: #99a3b3
                align: left

        row:
            gap: 8
            cross: center

            box:
                icon: clock
                iconsize: 14
                foreground: #99a3b3

            label:
                text: "включён: {time.uptime}"
                fontsize: 11
                foreground: #99a3b3
                align: left
