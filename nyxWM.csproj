<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Res/Pictures/logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Res/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The installer is a separate project; keep it out of the application's implicit globs. -->
    <Compile Remove="nyxinstaller/**" />
    <EmbeddedResource Remove="nyxinstaller/**" />
    <None Remove="nyxinstaller/**" />
  </ItemGroup>
</Project>