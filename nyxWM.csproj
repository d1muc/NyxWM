<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Res/Pictures/logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Res/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Editable .nx documents land in "themes" next to the executable. -->
    <None Remove="Themes\**\*" />
    <None Include="Themes\**\*" Link="themes\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- The built-in copy of theme.nx is compiled into the exe. It is the
         fallback when the editable file has an error. -->
    <EmbeddedResource Include="Themes/theme.nx" LogicalName="nyxWM.Themes.theme.default.nx" />
  </ItemGroup>
  <ItemGroup>
    <!-- The installer is a separate project; keep it out of the application's implicit globs. -->
    <Compile Remove="nyxinstaller/**" />
    <EmbeddedResource Remove="nyxinstaller/**" />
    <None Remove="nyxinstaller/**" />
  </ItemGroup>
</Project>