// ─── HOLOGRAM ─── Blue holographic aesthetic with chromatic aberration and scanlines.
// Switch: set "ThemeFile": "hologram.nx" in config.jsonc

// ---- colours --------------------------------------------------------------
accent:        #66ccff
accent-soft:   #7d66ccff
fg:            #ccf0ff
muted:         #6688aa
ok:            #66ddff
warn:          #ffcc44
bad:           #ff6688

// Translucent holographic surface.
bg:            #aa0a1520
bg-soft:       #88081218
bg-hover:      #2666ccff
stroke:        #4488aa

surface-opacity: 0.88

// ---- geometry -------------------------------------------------------------
radius:        8
radius-small:  6
gap:           10
padding:       8
font:          "Segoe UI"
size:          13
size-small:    11

// ---- animations -----------------------------------------------------------
animation pop:
    duration: 240ms
    easing: ease-out
    // Scanline-like vertical reveal — opacity + slight chroma shift.
    {
        opacity: 0
        scale: 0.92
    }
    100% {
        opacity: 1
        scale: 1
    }

// Quick shimmer, like an unstable hologram.
animation breathe:
    duration: 600ms
    loop: true
    alternate: true
    easing: sine
    {
        opacity: 0.6
        scale: 0.95
    }
    100% {
        opacity: 1
        scale: 1.05
    }

animation slide-in:
    duration: 200ms
    easing: ease-out
    {
        opacity: 0
        offsetx: -10
    }
    100% {
        opacity: 1
        offsetx: 0
    }

// Cyan-blue glow, like a flickering projection.
animation glow:
    duration: 700ms
    loop: true
    alternate: true
    easing: sine
    {
        background: #1866ccff
        foreground: $muted
    }
    100% {
        background: #4466ccff
        foreground: $fg
    }

animation sweep:
    duration: 1800ms
    loop: true
    easing: linear
    {
        opacity: 0.3
    }
    50% {
        opacity: 1
    }
    100% {
        opacity: 0.3
    }