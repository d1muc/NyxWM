// ─── NATURE LEAVES ─── Soft green tones with leaf-particle growth along window perimeters.
// Switch: set "ThemeFile": "nature-leaves.nx" in config.jsonc

// ---- colours --------------------------------------------------------------
accent:        #88cc66
accent-soft:   #7d88cc66
fg:            #e6f0d8
muted:         #7a9a68
ok:            #88cc66
warn:          #ddcc55
bad:           #cc6655

// Soft forest-floor background.
bg:            #cc0f1a0f
bg-soft:       #990a140a
bg-hover:      #2688cc66
stroke:        #558844

surface-opacity: 0.93

// ---- geometry -------------------------------------------------------------
radius:        16
radius-small:  12
gap:           10
padding:       8
font:          "Segoe UI"
size:          13
size-small:    11

// ---- animations -----------------------------------------------------------
animation pop:
    duration: 320ms
    easing: ease-out
    {
        opacity: 0
        scale: 0.8
    }
    100% {
        opacity: 1
        scale: 1
    }

// Gentle breathing like leaves in wind.
animation breathe:
    duration: 2200ms
    loop: true
    alternate: true
    easing: sine
    {
        opacity: 0.6
        scale: 0.92
    }
    100% {
        opacity: 1
        scale: 1.08
    }

animation slide-in:
    duration: 300ms
    easing: ease-out
    {
        opacity: 0
        offsetx: -16
    }
    100% {
        opacity: 1
        offsetx: 0
    }

// Soft green glow — like sunlight through leaves.
animation glow:
    duration: 1800ms
    loop: true
    alternate: true
    easing: sine
    {
        background: #2288cc66
        foreground: $muted
    }
    100% {
        background: #5588cc66
        foreground: $fg
    }

animation sweep:
    duration: 2600ms
    loop: true
    easing: linear
    {
        opacity: 0.3
    }
    50% {
        opacity: 1
    }
    100% {
        opacity: 0.3
    }

// ── Leaf-sprout animation: particles grow and fade outward ──
animation sprout:
    duration: 600ms
    easing: ease-out
    {
        opacity: 0
        scale: 0
    }
    100% {
        opacity: 1
        scale: 1
    }