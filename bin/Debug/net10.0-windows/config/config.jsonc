{
  "FallbackRefreshRate": 60,
  "LerpRatePerSecond": 8,
  "AutoCenterOnFocusDefault": true,
  "PauseOnFullscreen": true,
  "MainMod": "CONTROL+ALT",
  "CameraMoveButton": "MBUTTON",
  "CameraSensitivity": 0.5,
  "IgnoredWindowClassNames": [
    "Shell_TrayWnd",
    "Progman",
    "WorkerW",
    "CEF-OSC-WIDGET",
    "NvOverlayWindow"
  ],
  "Hotkeys": {
    "ResetCamera": "mainmod + space",
    "ToggleAutoCenter": "mainmod + t",
    "CloseWindow": "mainmod + c",
    "CenterActiveWindow": "mainmod + f",
    "ToggleGameMode": "mainmod + g"
  },
  "LaunchApps": {
    // Add hotkeys to launch programs here, e.g.:
    // "mainmod + 1": "C:\\Windows\\notepad.exe",
    // "mainmod + 2": "D:\\Games\\example.exe"
    "mainmod + n": "C:\\Windows\\notepad.exe",
    "mainmod + v": "C:\\Users\\ADMIN\\OneDrive\\Desktop\\рабочий стол\\Visual Studio Code.lnk",
    "mainmod + d": "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Google Chrome.lnk"
  }
}